{
  "name": "@de-web-sdk/core",
  "version": "0.1.0-alpha.0",
  "description": "Core library for agent packs: the pack format, provenance verification, composition, the check adapter contract, and baselines.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roughcompass/de-web-sdk.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/roughcompass/de-web-sdk/tree/main/packages/core#readme",
  "bugs": "https://github.com/roughcompass/de-web-sdk/issues",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "exports": {
